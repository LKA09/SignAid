# Optional runtime overrides. Copy to .env only when your process manager loads it.
SIGNAID_DATA_DIR=./data
SIGNAID_FPS=20
SIGNAID_TRANSITION_FRAMES=4
SIGNAID_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional isolated SignAvatars Python executable. The browser VRM renderer
# works without this setting.
# SIGNAVATARS_PYTHON=C:\path\to\signavatars\python.exe
#
